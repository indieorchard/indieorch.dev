---
const currentYear = 2026;
---

<footer class="border-t border-border">
  <div class="max-w-content mx-auto px-5 sm:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Wordmark -->
      <div class="col-span-2 sm:col-span-2 space-y-3">
        <a href="/" class="inline-flex items-center gap-2.5">
          <img
            src="/indieorch-symbol.png"
            alt="IndieOrch logo"
            class="w-6 h-6 object-contain"
            width="24"
            height="24"
          />
          <span class="font-bold text-[15px] tracking-tight text-ink">IndieOrch</span>
        </a>
        <p class="text-ink-muted text-[13px] leading-relaxed max-w-xs">
          Independent software. Privacy by design.<br />
          Local-first tools for creators, professionals and developers.
        </p>
        <a
          href="mailto:support@indieorch.dev"
          class="inline-block text-[12px] font-mono text-ink-muted hover:text-ink transition-colors"
        >
          support@indieorch.dev
        </a>
      </div>

      <!-- Col 2: Products -->
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-ink-faint mb-4">Products</h3>
        <ul class="space-y-2.5 text-[13px]">
          <li>
            <a
              href="https://nocaputils.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-muted hover:text-ink transition-colors inline-flex items-center gap-1 group"
            >
              <span>NoCapUtils</span>
              <svg class="w-2.5 h-2.5 opacity-0 group-hover:opacity-60 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://apps.microsoft.com/detail/9nm785c34320?hl=en-US&gl=AE"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-muted hover:text-ink transition-colors inline-flex items-center gap-1 group"
            >
              <span>PII Shield</span>
              <svg class="w-2.5 h-2.5 opacity-0 group-hover:opacity-60 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </a>
          </li>
          <li>
            <span class="text-ink-muted/60 flex items-center gap-2 text-[13px]">
              Observability
              <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-surface-subtle border border-border text-ink-faint tracking-wide">
                Soon
              </span>
            </span>
          </li>
        </ul>
      </div>

      <!-- Col 3: Studio -->
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-widest text-ink-faint mb-4">Studio</h3>
        <ul class="space-y-2.5 text-[13px]">
          <li><a href="/#philosophy" class="text-ink-muted hover:text-ink transition-colors">Philosophy</a></li>
          <li><a href="/#about" class="text-ink-muted hover:text-ink transition-colors">About</a></li>
          <li><a href="/contact" class="text-ink-muted hover:text-ink transition-colors">Contact</a></li>
          <li><a href="/privacy" class="text-ink-muted hover:text-ink transition-colors">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="pt-6 border-t border-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-[12px] text-ink-faint">
      <p>© {currentYear} IndieOrch. All rights reserved.</p>
      <p class="text-[11px] text-ink-faint/70">Independent software studio. Privacy-first by design.</p>
    </div>
  </div>
</footer>
