---
const currentYear = 2026;
---

<footer class="border-t border-border mt-24">
  <div class="max-w-content mx-auto px-6 sm:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-8 mb-16">
      <!-- Col 1: Wordmark & Tagline -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-5 h-5 rounded bg-ink flex items-center justify-center p-0.5">
            <svg viewBox="0 0 32 32" fill="none" class="w-full h-full">
              <circle cx="11" cy="11" r="3.5" fill="#FAFAF8"/>
              <circle cx="21" cy="11" r="3.5" fill="#FAFAF8"/>
              <circle cx="16" cy="21" r="3.5" fill="#FAFAF8"/>
              <path d="M11 11L16 21L21 11" stroke="#FAFAF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-semibold text-[15px] tracking-tight text-ink">IndieOrch</span>
        </a>
        <p class="text-ink-muted text-[14px] leading-relaxed max-w-sm">
          Independent software. Privacy by design.<br />
          Thoughtful, focused tools built for individuals, creators, and developers.
        </p>
      </div>

      <!-- Col 2: Products -->
      <div>
        <h3 class="text-[12px] font-semibold uppercase tracking-wider text-ink-faint mb-4">
          Products
        </h3>
        <ul class="space-y-2.5 text-[14px]">
          <li>
            <a
              href="https://nocaputils.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-muted hover:text-ink transition-colors inline-flex items-center gap-1 group"
            >
              <span>NoCapUtils</span>
              <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://nocaputils.com/pii-shield"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-muted hover:text-ink transition-colors inline-flex items-center gap-1 group"
            >
              <span>PII Shield</span>
              <svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </a>
          </li>
          <li>
            <span class="text-ink-muted/80 flex items-center gap-2">
              <span>Observability</span>
              <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-surface-subtle border border-border text-ink-muted">
                Soon
              </span>
            </span>
          </li>
        </ul>
      </div>

      <!-- Col 3: Studio & Inquiries -->
      <div>
        <h3 class="text-[12px] font-semibold uppercase tracking-wider text-ink-faint mb-4">
          Studio
        </h3>
        <ul class="space-y-2.5 text-[14px]">
          <li>
            <a href="/#about" class="text-ink-muted hover:text-ink transition-colors">
              About
            </a>
          </li>
          <li>
            <a href="/#philosophy" class="text-ink-muted hover:text-ink transition-colors">
              Philosophy
            </a>
          </li>
          <li>
            <a href="/contact" class="text-ink-muted hover:text-ink transition-colors">
              Contact
            </a>
          </li>
          <li>
            <a
              href="mailto:support@indieorch.dev"
              class="text-ink-muted hover:text-ink transition-colors font-mono text-[13px]"
            >
              support@indieorch.dev
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Separator & Legal -->
    <div class="pt-8 border-t border-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-[13px] text-ink-muted">
      <p>© {currentYear} IndieOrch. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-ink transition-colors">
          Privacy Policy
        </a>
        <a href="mailto:support@indieorch.dev" class="hover:text-ink transition-colors">
          support@indieorch.dev
        </a>
      </div>
    </div>
  </div>
</footer>
