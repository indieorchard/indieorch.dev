---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact IndieOrch — Support, Feedback and Collaboration"
  description="Contact IndieOrch for product support, feature feedback, early access to Observability tools, or collaboration inquiries. We read and reply to all genuine enquiries."
  canonicalPath="/contact"
>
  <div class="py-16 sm:py-24">
    <div class="max-w-content mx-auto px-5 sm:px-8">
      <div class="max-w-xl">
        <!-- Breadcrumb -->
        <div class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-ink-faint mb-6">
          <a href="/" class="hover:text-ink transition-colors">Home</a>
          <span>/</span>
          <span class="text-ink">Contact</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold tracking-tightest text-ink mb-5 leading-tight">
          Have a question? Let's talk.
        </h1>

        <p class="text-[15px] sm:text-[16px] text-ink-muted leading-relaxed mb-10">
          Product questions, technical support, feature feedback, early access requests or collaboration ideas. We read and reply to everything.
        </p>

        <!-- Contact card -->
        <div class="p-7 sm:p-9 rounded-2xl border border-border bg-surface mb-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 pb-7 border-b border-border">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-widest text-ink-faint block mb-1.5">Email</span>
              <a
                href="mailto:support@indieorch.dev"
                class="text-lg sm:text-xl font-mono font-semibold text-ink hover:text-accent transition-colors"
              >
                support@indieorch.dev
              </a>
            </div>
            <a
              href="mailto:support@indieorch.dev"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-ink text-canvas font-semibold text-[14px] hover:bg-neutral-800 transition-colors shrink-0"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Email us
            </a>
          </div>

          <p class="text-[13px] text-ink-muted leading-relaxed pt-6">
            We typically respond to genuine product enquiries and support requests as soon as possible.
          </p>
        </div>

        <!-- Topic cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="p-4 rounded-xl border border-border bg-surface-subtle text-[13px]">
            <span class="font-bold text-ink block mb-1">Product Support</span>
            <p class="text-ink-muted text-[12px]">Help with NoCapUtils or PII Shield on Windows.</p>
          </div>
          <div class="p-4 rounded-xl border border-border bg-surface-subtle text-[13px]">
            <span class="font-bold text-ink block mb-1">Early Access</span>
            <p class="text-ink-muted text-[12px]">Request access to the Observability beta.</p>
          </div>
          <div class="p-4 rounded-xl border border-border bg-surface-subtle text-[13px]">
            <span class="font-bold text-ink block mb-1">Partnerships</span>
            <p class="text-ink-muted text-[12px]">Integrations, tooling or press enquiries.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
