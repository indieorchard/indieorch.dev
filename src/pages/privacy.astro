---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Privacy Policy — IndieOrch"
  description="IndieOrch Privacy Policy. We do not track, profile, or sell your personal information."
  canonicalPath="/privacy"
>
  <div class="py-20 sm:py-28">
    <div class="max-w-content mx-auto px-6 sm:px-8">
      <div class="max-w-2xl">
        <!-- Breadcrumb -->
        <div class="inline-flex items-center gap-2 text-[12px] font-semibold uppercase tracking-wider text-ink-faint mb-6">
          <a href="/" class="hover:text-ink transition-colors">Home</a>
          <span>/</span>
          <span class="text-ink">Privacy</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold tracking-tightest text-ink mb-6">
          Privacy Policy
        </h1>

        <p class="text-sm font-mono text-ink-faint mb-10">
          Effective date: November 2026
        </p>

        <div class="space-y-8 text-[15px] text-ink-muted leading-relaxed border-t border-border pt-8">
          <div>
            <h2 class="text-lg font-bold text-ink mb-2">Our Commitment</h2>
            <p>
              IndieOrch is founded on the conviction that privacy is a baseline right, not an optional setting. We design our software to prevent data collection at the source.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-ink mb-2">Website & Tracking</h2>
            <p>
              This website (<code>indieorch.dev</code>) does not use cookies, advertising identifiers, session replay tools, or third-party behavioral analytics scripts.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-ink mb-2">Product Data Processing</h2>
            <p>
              Our utilities and applications (such as NoCapUtils and PII Shield) operate on a local-first architecture. Any documents, files, or sensitive content you process with these tools remain on your device and are never transmitted to our servers.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-ink mb-2">Correspondence</h2>
            <p>
              When you email us at <a href="mailto:support@indieorch.dev" class="text-ink underline">support@indieorch.dev</a>, we use your message solely to respond to your inquiry. We do not sell or share contact details with advertisers.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-ink mb-2">Contact</h2>
            <p>
              Questions regarding privacy can be directed to <a href="mailto:support@indieorch.dev" class="text-ink underline">support@indieorch.dev</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
